{
  "name": "mocap-backend-tester",
  "private": true,
  "version": "0.1.0",
  "description": "Pick videos, run the mocap pipeline, watch the result. For testing the backend without the web app.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "tsc -p tsconfig.main.json && node --test test/*.test.cjs",
    "preview": "vite"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
